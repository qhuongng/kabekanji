# Copy this file to .env and adjust the values for your environment

# Base URL where this server is reachable
# Used to build the wallpaper API URL shown in the UI
# For local development: http://localhost:8000
# For a deployed server: https://your-domain.example.com
SERVER_URL=http://localhost:8000

# iCloud share link for the published kabekanji iOS Shortcut
# Get this from Shortcuts app > your shortcut > Share > Copy iCloud Link
# Leave empty to hide the install button in the UI
SHORTCUT_URL=
